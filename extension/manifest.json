{
  "manifest_version": 3,
  "name": "ShieldMail — Email Threat Detector",
  "short_name": "ShieldMail",
  "description": "Analyze .eml files for phishing, BEC, malware, and fraud — powered by AI/ML forensic intelligence.",
  "version": "1.0.0",
  "permissions": ["activeTab", "downloads", "notifications", "storage", "scripting"],
  "host_permissions": [
    "http://localhost:8000/*",
    "http://localhost:5173/*",
    "https://mail.google.com/*"
  ],
  "content_scripts": [
    {
      "matches": ["https://mail.google.com/*"],
      "js": ["gmail_content.js"],
      "css": ["gmail_inject.css"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["extract_ik.js"],
      "matches": ["https://mail.google.com/*"]
    }
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
